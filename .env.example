# Copie este arquivo para .env e preencha os valores.

PORT=3000
# Endereço público do site (usado no link de notificação da BlackCat).
# Na Railway pode deixar vazio: o site usa sozinho o domínio que a Railway gerar.
PUBLIC_URL=http://localhost:3000

# Pasta do banco de dados e dos arquivos enviados pelo painel. Na Railway é o volume (automático).
# DATA_DIR=

# No ar, o modo de teste fica com as vendas FECHADAS. Para testar o fluxo no ar com pagamento
# simulado, use ALLOW_SIMULATE=true (e volte para false antes de divulgar!).
# ALLOW_SIMULATE=false

# ---------- Ebook ----------
EBOOK_TITLE=Meu Ebook
EBOOK_SUBTITLE=O guia completo para você começar hoje
EBOOK_PRICE_CENTS=4790
# Arquivo do ebook. Opcional: o mais fácil é enviar pelo painel /admin.
# EBOOK_FILE=private/ebook.pdf

# ---------- Prêmio ----------
PRIZE_TITLE=Bônus exclusivo
PRIZE_DESCRIPTION=Parabéns! Seu certificado foi validado e você ganhou um material bônus.
# Arquivo do prêmio. Opcional: o mais fácil é enviar pelo painel /admin.
# Coloque PRIZE_FILE= (vazio) se o prêmio não for um arquivo.
# PRIZE_FILE=private/premio.pdf

# ---------- Pagamento ----------
# "mock" = modo de teste (botão "simular pagamento"). "blackcat" = cobrança real.
PAYMENT_PROVIDER=mock

# Dados da BlackCat (painel da BlackCat > Integrações / API)
BLACKCAT_API_URL=https://api.blackcatpay.com.br
# Chave secreta (sk_live_...) e chave pública (pk_live_...). NUNCA coloque no GitHub nem mande por chat.
BLACKCAT_SECRET_KEY=
BLACKCAT_PUBLIC_KEY=
# Forma de autenticação. Deixe vazio e rode "npm run testar-blackcat": ele descobre e diz o valor certo.
BLACKCAT_AUTH=
# Caminhos da API. Confira na documentação da BlackCat e ajuste se for diferente.
BLACKCAT_CREATE_PATH=/api/sales/create-sale
BLACKCAT_STATUS_PATH=/api/sales/{id}/status
# Segredo que vai no link de notificação (webhook). Use um texto longo e aleatório.
WEBHOOK_SECRET=troque-este-segredo

# ---------- Painel (/admin) ----------
# Usuário: admin. Senha: a que você colocar aqui (use uma senha forte). Vazio = painel desligado.
ADMIN_PASSWORD=
